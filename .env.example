# Copy to .env for local runs. Names and placeholders only: never commit real values.
# lucerne-temp needs no secret at all; every variable below is optional.

# Port of the API (Cloud Run sets this itself)
PORT=8080

# Where the batch job writes and the UI reads. Local path, or gs://your-bucket/latest.csv (needs gcsfs)
PREDICTIONS_URI=predictions/latest.csv

# Where the UI finds the API
API_URL=http://localhost:8080

# Live data source. Point it at an unreachable URL to see the snapshot fallback.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Your own project will need these; the values belong in Secret Manager / GitHub secrets
# MLFLOW_TRACKING_URI=https://your-mlflow-host
# MLFLOW_TRACKING_PASSWORD=<from Secret Manager>
